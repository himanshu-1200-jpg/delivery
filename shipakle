// Background Message Handler (App band hone par background mein message capture karega)
@pragma('vm:entry-point')
Future<void> _firebaseMessagingBackgroundHandler(
    RemoteMessage message) async {
  if (Firebase.apps.isEmpty) {
    await Firebase.initializeApp();
  }

  debugPrint(
    "Background message received in Delivery Panel: "
        "${message.messageId}",
  );
}

void main() async {
  WidgetsFlutterBinding.ensureInitialized();
  await Firebase.initializeApp();

  // Background messaging handler register karein
  FirebaseMessaging.onBackgroundMessage(_firebaseMessagingBackgroundHandler);

  await DeliveryNotificationService.initialize();


  runApp(const MaterialApp(
    debugShowCheckedModeBanner: false,
    home: DeliveryAuthCheck(),
  ));
}

// 1. Check karein ki delivery boy pehle से login hai ya nahi
class DeliveryAuthCheck extends StatefulWidget {
  const DeliveryAuthCheck({super.key});

  @override
  State<DeliveryAuthCheck> createState() => _DeliveryAuthCheckState();
}

class _DeliveryAuthCheckState extends State<DeliveryAuthCheck> {
  bool _isLoading = true;
  bool _isLoggedIn = false;
  String _savedBoyName = '';

  @override
  void initState() {
    super.initState();
    _checkLoginStatus();
  }

  void _checkLoginStatus() async {
    SharedPreferences prefs = await SharedPreferences.getInstance();
    String? boyName = prefs.getString('deliveryBoyName');
    if (boyName != null && boyName.isNotEmpty) {
      setState(() {
        _isLoggedIn = true;
        _savedBoyName = boyName;
        _isLoading = false;
      });
    } else {
      setState(() {
        _isLoading = false;
      });
    }
  }

  @override
  Widget build(BuildContext context) {
    if (_isLoading) {
      return const Scaffold(
        backgroundColor: Color(0xFF140507),
        body: Center(child: CircularProgressIndicator(color: Color(0xFFFF5722))),
      );
    }
    return _isLoggedIn ? DeliveryDashboard(deliveryBoyName: _savedBoyName) : const DeliveryLoginPage();
  }
}

